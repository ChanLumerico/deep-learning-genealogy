{
  "name": "deep-learning-genealogy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive phylogeny of deep learning architectures, 1957\u20132025",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node tools/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden": "node tools/gen-golden.mjs",
    "prerender": "node tools/prerender.mjs"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
