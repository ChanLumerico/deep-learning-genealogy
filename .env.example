# Accounts are optional. Without these the site runs exactly as it always has:
# the reading list lives in localStorage and there is no sign-in button.
#
# Both values are the publishable ones and are meant to appear in the bundle;
# what protects a reader's rows is the row-level security in
# supabase/schema.sql, not the secrecy of this key.
#
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
